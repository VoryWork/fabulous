# neural/ — 实验区
# 上游仓库通过 git clone 拉取，不入库
neural/lv-chordia/
neural/beat_this/
neural/all-in-one-infer/

# ONNX 导出产物（可由脚本重新生成，体积大）
neural/exported/
*.onnx
*.onnx.data

# 模型权重：任何格式都不入库（下载/导出物，体积大且可重新获取）
# .gitignore 只挡未跟踪文件；已经 commit 过的仍会被跟踪，所以要靠 review 挡住。
*.pt
*.pth
*.ckpt
*.safetensors
*.sdict
*.npy
# neural/golden 里的 .npy 是入库的基准数据（1MB），不能挡
!neural/golden/*.npy
neural/weights/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 前端 / Rust（后续加入）
node_modules/
dist/
target/
src-tauri/target/

# 系统
.DS_Store
Thumbs.db

# client/ (Tauri + Vue)
client/node_modules/
client/dist/
client/src-tauri/target/
client/src-tauri/gen/

# 临时产物（调试截图、一次性脚本、分析输出）
tmp-*.ts
tmp-*.mjs
tmp-*.json
tmp-*.png
*.log

# 人工截图 / 素材（体积大，不是源码）
/*.png
/*.html

# 调试截图 / 验证图（不是源码）
client/shots/
neural/**/*.png
neural/o.json

# 体积大的 golden 基准（可由脚本重新生成）
neural/exported_refrain/

# 上游模型仓库（git clone 拉取）
neural/demucs-infer/

# 打包产物（zip 90MB+，可由打包脚本重新生成）
dist-zip/

# 目录内临时文件（调试日志 / 一次性脚本 / 验证截图）
client/.tmp-*
client/tmp-*

# ONNX Runtime 动态库（18.9MB，从 onnxruntime 1.31.x 取，不入库）
# 开发期：拷贝自 conda 环境的 site-packages/onnxruntime/capi/onnxruntime.dll
# 打包期：应该作为 Tauri resource 分发
client/src-tauri/onnxruntime.dll
